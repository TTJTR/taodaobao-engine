APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_AI_MODE=mock
APP_FEISHU_MODE=mock
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55433/taodaobao_v1
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_FRONTEND_REDIRECT_URL=http://127.0.0.1:8000/
APP_SESSION_SECRET=replace-with-a-long-random-secret
APP_COOKIE_SECURE=false
APP_FEISHU_APP_ID=
APP_FEISHU_APP_SECRET=
APP_FEISHU_VERIFICATION_TOKEN=
APP_INVITATION_REQUIRED=false
APP_INVITATION_CODE=

# Docker production deployment
DOMAIN=localhost
POSTGRES_DB=taodaobao
POSTGRES_USER=taodaobao
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# AI service (fill secrets only in .env; never commit the real key)
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TIMEOUT_SECONDS=60
BAILIAN_MAX_RETRIES=2
