APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_AI_MODE=live
APP_REHEARSAL_AI_TIMEOUT_SECONDS=20
APP_REHEARSAL_AI_MAX_PROMPT_CHARACTERS=36000
APP_FEISHU_MODE=live
APP_PRESENTATION_MODE=live
APP_PRESENTATION_SERVICE_URL=
APP_PRESENTATION_SERVICE_API_KEY=
# AI 互动 HTML 演示。密钥只写入部署环境，不得提交到仓库。
APP_INTERACTIVE_HTML_MODE=live
APP_INTERACTIVE_HTML_BASE_URL=https://api.deepseek.com
APP_INTERACTIVE_HTML_API_KEY=
APP_INTERACTIVE_HTML_MODEL=deepseek-chat
APP_INTERACTIVE_HTML_TIMEOUT_SECONDS=180
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55433/taodaobao_v1
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_FRONTEND_REDIRECT_URL=http://127.0.0.1:8000/
APP_SESSION_SECRET=replace-with-a-long-random-secret
APP_COOKIE_SECURE=false
# Trusted shared directory used by both API and Worker for real tender uploads.
APP_TENDER_STORAGE_ROOT=.local/tender-artifacts
APP_FEISHU_APP_ID=
APP_FEISHU_APP_SECRET=
APP_FEISHU_VERIFICATION_TOKEN=
APP_FEISHU_ENCRYPT_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_FEISHU_TOKEN_ENCRYPTION_KEY=
# Must exactly match the user scopes enabled in Feishu Open Platform.
APP_FEISHU_SCOPES=offline_access docx:document space:document:retrieve wiki:wiki:readonly docs:permission.member:retrieve bitable:app minutes:minutes.search:read minutes:minutes.basic:read minutes:minutes.transcript:export
APP_INTEGRATION_STATE_DIR=.local/integrations
APP_INVITATION_REQUIRED=false
APP_INVITATION_CODE=
APP_INVITATION_SIGNING_SECRET=
APP_INVITATION_TTL_SECONDS=600
APP_INVITATION_MAX_TOKEN_TTL_SECONDS=2592000

# Docker production deployment
DOMAIN=localhost
POSTGRES_DB=taodaobao
POSTGRES_USER=taodaobao
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# AI service (fill secrets only in .env; never commit the real key)
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TIMEOUT_SECONDS=60
BAILIAN_MAX_RETRIES=2

# Alibaba Model Studio web search. Reuses DASHSCOPE_API_KEY by default.
# APP_BAILIAN_SEARCH_API_KEY may be set only when search uses a separate key.
APP_BAILIAN_SEARCH_API_KEY=
APP_BAILIAN_SEARCH_MODEL=qwen-plus
APP_BAILIAN_SEARCH_STRATEGY=turbo
APP_BAILIAN_SEARCH_TIMEOUT_SECONDS=45
APP_BAILIAN_SEARCH_MAX_RESULTS=8
APP_USAGE_MONITOR_TOKEN=

# Open Enrich internal Sidecar. In Docker Compose this is injected into app/worker
# as http://open-enrich-sidecar:8090. Do not use a public URL in production.
APP_OPEN_ENRICH_SVC_URL=
# Required shared internal token. Generate a random value of at least 32 bytes and
# inject the same value into app, worker and Sidecar. Never expose it to browsers.
APP_OPEN_ENRICH_SVC_TOKEN=replace-with-a-long-random-internal-token
APP_OPEN_ENRICH_POLL_SECONDS=10
OPEN_ENRICH_JOB_TTL_SECONDS=86400

# Open Enrich paid providers. Store real values only in .env or a secret manager.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=serp_api1
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1
OPENROUTER_API_KEY=
# OpenRouter model ID; must support tools/tool_choice and structured output.
OPEN_ENRICH_MODEL=qwen/qwen-plus
