# 淘到宝引擎 Local First 配置。复制为 .env；真实密钥不得提交 Git。

# ---------- 本机监听与访问地址 ----------
# 127.0.0.1 仅本机；0.0.0.0 允许局域网（请同时配置系统防火墙）。
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
COOKIE_SECURE=false

APP_ENV=production
APP_DEBUG=false
APP_API_PREFIX=/api/v1
APP_HOST=127.0.0.1
APP_PORT=8000
APP_FRONTEND_PORT=3000
APP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_LOG_LEVEL=INFO
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000
APP_FRONTEND_REDIRECT_URL=http://127.0.0.1:3000/

# ---------- 本地身份与安全 ----------
AUTH_MODE=local
APP_AUTH_MODE=local
APP_LOCAL_ADMIN_USERNAME=admin
APP_LOCAL_ADMIN_PASSWORD=replace-with-a-long-local-password
APP_SESSION_SECRET=replace-with-a-long-random-session-secret
# Fernet key。可运行 scripts/start-local.ps1 自动生成。
APP_SECRET_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
APP_COOKIE_SECURE=false
APP_INVITATION_REQUIRED=false
APP_INVITATION_CODE=
APP_INVITATION_SIGNING_SECRET=
APP_INVITATION_TTL_SECONDS=600
APP_INVITATION_MAX_TOKEN_TTL_SECONDS=2592000

# ---------- PostgreSQL / Redis ----------
POSTGRES_DB=taodaobao
POSTGRES_USER=taodaobao
POSTGRES_PASSWORD=replace-with-a-long-database-password
# 宿主机直跑使用此地址；Docker Compose 会安全覆盖为 db:5432。
APP_DATABASE_URL=postgresql+asyncpg://taodaobao:replace-with-a-long-database-password@127.0.0.1:5432/taodaobao
# 宿主机直跑使用此地址；Docker Compose 会覆盖为 redis:6379。
APP_REDIS_URL=redis://127.0.0.1:6379/0

# ---------- OpenAI Schema 兼容 AI / Embedding ----------
APP_AI_MODE=live
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
BAILIAN_TIMEOUT_SECONDS=60
BAILIAN_MAX_RETRIES=2
BAILIAN_RETRY_BACKOFF_SECONDS=0.5
BAILIAN_TEMPERATURE=0.1
# 旧版兼容变量，可留空；AI_API_KEY 优先。
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=

# ---------- 文件与长任务 ----------
APP_FILE_STORAGE_ROOT=.local/uploads
APP_TENDER_STORAGE_ROOT=.local/uploads/tenders
APP_PRESENTATION_EXPORT_DIR=.local/exports
APP_INTEGRATION_STATE_DIR=.local/integrations
APP_REHEARSAL_AI_TIMEOUT_SECONDS=20
APP_REHEARSAL_AI_MAX_PROMPT_CHARACTERS=36000

# ---------- 可选能力开关 ----------
ENABLE_FEISHU=false
ENABLE_PUBLIC_INTELLIGENCE=false
ENABLE_DEMO_DATA=false
TENDER_PARSER_BACKEND=lightweight
APP_ENABLE_FEISHU=false
APP_ENABLE_PUBLIC_INTELLIGENCE=false
APP_ENABLE_DEMO_DATA=false

# 飞书：ENABLE_FEISHU=true 且 AUTH_MODE=both/feishu 后才启用。
APP_FEISHU_MODE=live
APP_FEISHU_APP_ID=
APP_FEISHU_APP_SECRET=
APP_FEISHU_CALLBACK_URL=http://127.0.0.1:3000/api/v1/auth/feishu/callback
APP_FEISHU_VERIFICATION_TOKEN=
APP_FEISHU_ENCRYPT_KEY=
# 旧版兼容；未填写时统一使用 APP_SECRET_ENCRYPTION_KEY。
APP_FEISHU_TOKEN_ENCRYPTION_KEY=
APP_FEISHU_SCOPES=offline_access docx:document space:document:retrieve wiki:wiki:readonly docs:permission.member:retrieve bitable:app minutes:minutes.search:read minutes:minutes.basic:read minutes:minutes.transcript:export

# 互动 HTML（可选）
APP_INTERACTIVE_HTML_MODE=live
APP_INTERACTIVE_HTML_BASE_URL=https://api.deepseek.com
APP_INTERACTIVE_HTML_API_KEY=
APP_INTERACTIVE_HTML_MODEL=deepseek-chat
APP_INTERACTIVE_HTML_TIMEOUT_SECONDS=180

# 历史展示解析 Provider（可选）
APP_PRESENTATION_MODE=live
APP_PRESENTATION_SERVICE_URL=
APP_PRESENTATION_SERVICE_API_KEY=

# 百炼公开搜索（可选；仅在公开情报开关开启时生效）
APP_BAILIAN_SEARCH_API_KEY=
APP_BAILIAN_SEARCH_MODEL=qwen-plus
APP_BAILIAN_SEARCH_STRATEGY=turbo
APP_BAILIAN_SEARCH_TIMEOUT_SECONDS=45
APP_BAILIAN_SEARCH_MAX_RESULTS=8

# Open Enrich 补充情报（可选，需要 --profile intelligence-live）
APP_OPEN_ENRICH_SVC_URL=
APP_OPEN_ENRICH_SVC_TOKEN=replace-with-a-long-random-internal-token
APP_OPEN_ENRICH_POLL_SECONDS=10
OPEN_ENRICH_JOB_TTL_SECONDS=86400
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=serp_api1
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1
OPENROUTER_API_KEY=
OPEN_ENRICH_MODEL=qwen/qwen-plus

# 运维接口独立令牌（可选）
APP_USAGE_MONITOR_TOKEN=
