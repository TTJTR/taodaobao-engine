APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_AI_MODE=mock
APP_FEISHU_MODE=mock
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taodaobao
